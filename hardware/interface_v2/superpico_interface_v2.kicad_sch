)) (stroke (width 0) (type default)) (uuid "8f6ae6f8-f930-5f58-ac75-b18bcc936596"))(global_label "GND" (shape bidirectional) (at 212.09 105.41 180) (effects (font (size 0.9 0.9)) (justify left) ) (uuid "b5a7a012-8f3f-57ee-bdf9-94793aae2428") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 212.09 105.41 180) (effects (font (size 1 1)) hide)))(text "REV A - ENTWURF ZUR PRUEFUNG / NICHT FERTIGUNGSFREIGEGEBEN\nAdapter fuer ein separates RP2350B-Modul; keine PPU-QFP-Footprints, kein PCB-Layout.\n3V3_HOST muss dieselbe Versorgung wie RP2350-IOVDD sein. Keine zweite 3,3-V-Quelle verbinden.\n5V_SNES wird nur fuer den optionalen Rueckkanal benutzt; keine Verbindung zu 3V3_HOST.\nPGOOD-Verzoegerung: fruehe Registerwrites koennen fehlen. Beide Systeme zusammen starten;\nStartup-Sequenz/Resetdauer vor Freigabe messen. Erstes gueltiges $2100-Write hebt Bildsperre auf." (at 25 128 0) (effects (font (size 1.27 1.27)) (justify left top) ) (uuid "3511ec5c-50f5-50dd-8e8b-8070d6999570"))(sheet (at 20 180) (size 112 17) (stroke (width 0.254) (type default)) (fill (color 0 0 0 0)) (uuid "11d3697e-9adf-51f2-a2d9-97cd1fe164f9") (property "Sheetname" "01 | RGB und PPU-Timing: 5 V auf 3,3 V" (at 20 179 0) (effects (font (size 0.95 0.95)) (justify left bottom) )) (property "Sheetfile" "video.kicad_sch" (at 20 198 0) (effects (font (size 0.85 0.85)) (justify left top) )) (instances (project "superpico_interface_v2" (path "/b0de0455-206d-5069-98fa-b54c7b984689" (page "2")))))(sheet (at 145 180) (size 112 17) (stroke (width 0.254) (type default)) (fill (color 0 0 0 0)) (uuid "c796f6ca-9b05-54b2-a70e-1ffd8a50bb50") (property "Sheetname" "02 | Audio und PPU-Schreibbus: 5 V auf 3,3 V" (at 145 179 0) (effects (font (size 0.95 0.95)) (justify left bottom) )) (property "Sheetfile" "bus.kicad_sch" (at 145 198 0) (effects (font (size 0.85 0.85)) (justify left top) )) (instances (project "superpico_interface_v2" (path "/b0de0455-206d-5069-98fa-b54c7b984689" (page "3")))))(sheet (at 270 180) (size 11